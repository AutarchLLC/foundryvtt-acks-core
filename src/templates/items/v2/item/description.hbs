<section class="tab {{ tab.cssClass }} description" data-group="primary" data-tab="description">
  <div class="content">
    {{! getDetailsPartialPath will return partial based on item's type }}
    {{! systems/acks/templates/items/v2/details/details-ITEM_TYPE.hbs }}
    {{! See AcksItemSheetV2 _prepareDescriptionContext }}
    {{> (getDetailsPartialPath) }}

    <div class="item-description">
      {{ tagList item.labels.all }}

      {{#if descriptionPartialName}}
        {{> (lookup . 'descriptionPartialName') }}
      {{/if}}

      <prose-mirror name="system.description" value="{{ system.description }}" document-uuid="{{ item.uuid }}" compact
                    toggled>{{{ enriched.description }}}</prose-mirror>
    </div>
  </div>
</section>
