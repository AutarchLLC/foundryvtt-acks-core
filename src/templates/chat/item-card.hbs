<section class="acksii chat-card item-card" data-actor-id="{{actorId}}" data-item-id="{{item.id}}"
         data-token-uuid="{{tokenUUID}}">

  <header class="card-header">
    <img class="card-header__img" src="{{item.img}}" alt="{{item.name}}" width="36" height="36"/>
    <h3 class="card-header__name">
      <a>{{item.name}}</a>
    </h3>
  </header>

  <div class="card-content expanded">
    <div class="card-content__description">
      {{{data.description}}}
    </div>
  </div>

  {{#if data.buttons}}
    <div class="card-buttons">
      {{#each data.buttons}}
        <button data-action="{{action}}" data-action-param="{{actionParam}}">{{label}}</button>
      {{/each}}
    </div>
  {{/if}}

  {{#if data.tags}}
    <footer class="card-footer">
      {{#each data.tags}}
        <span>{{this}}</span>
      {{/each}}
    </footer>
  {{/if}}

</section>
